<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>سفارش آنلاین | Mirzanin Mutfağı</title>
  <style>
    body{font-family:Tahoma,Arial; margin:0; background:#fafafa; color:#222}
    header{position:sticky; top:0; background:#fff; border-bottom:1px solid #eee; padding:14px 16px; z-index:10}
    .wrap{max-width:980px; margin:0 auto; padding:16px}
    h1{margin:0; font-size:18px}
    .sub{margin:6px 0 0 0; font-size:12px; color:#666}
    .tabs{display:flex; flex-wrap:wrap; gap:10px; margin-top:12px}
    .tab{border:1px solid #ddd; background:#fff; padding:10px 12px; border-radius:999px; cursor:pointer; font-size:13px}
    .tab.active{border-color:#111; background:#111; color:#fff}
    .grid{display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-top:12px}
    @media (max-width:720px){.grid{grid-template-columns:1fr}}
    .card{background:#fff; border:1px solid #eee; border-radius:18px; padding:14px}
    .row{display:flex; justify-content:space-between; gap:10px; align-items:flex-start}
    .name{font-weight:700; margin:0 0 6px 0}
    .desc{margin:0; font-size:13px; color:#555; line-height:1.7}
    .controls{display:flex; gap:10px; align-items:center; margin-top:12px}
    .btn{border:1px solid #ddd; background:#fff; padding:10px 12px; border-radius:12px; cursor:pointer; font-weight:700}
    .btn:active{transform:scale(.99)}
    .qty{min-width:44px; text-align:center; font-weight:800}

    .section{margin-top:16px}
    .note{width:100%; padding:12px; border:1px solid #ddd; border-radius:14px; font-size:14px; margin-top:12px}

    .stickyCart{
      position:sticky; bottom:0; background:#fff; border-top:1px solid #eee;
      padding:12px 16px;
    }
    .cartbar{max-width:980px; margin:0 auto; display:flex; gap:10px; align-items:center; justify-content:space-between}
    .total{font-weight:900}
    .primary{
      border:0; background:#111; color:#fff; padding:12px 14px; border-radius:14px; cursor:pointer; font-weight:900;
    }
    .primary:disabled{opacity:.5; cursor:not-allowed}
    .small{font-size:12px; color:#666}
    footer{padding:18px 16px; color:#666; font-size:12px; text-align:center}
  </style>
</head>
<body>

<header>
  <div class="wrap" style="padding:0; max-width:980px;">
    <h1>سفارش آنلاین | Mirzanin Mutfağı</h1>
    <p class="sub">آیتم‌ها رو انتخاب کن، تعداد بزن، بعد سفارش مستقیم به واتساپ ارسال میشه.</p>
  </div>

  <div class="wrap" style="padding-top:0; max-width:980px;">
    <div class="tabs" id="tabs"></div>
  </div>
</header>

<main class="wrap">
  <div class="grid" id="list"></div>

  <div class="section">
    <div class="card">
      <div class="row">
        <div>
          <p class="name">توضیحات سفارش (اختیاری)</p>
          <p class="desc">مثلاً: بدون پیاز، تند، زمان تحویل، توضیح برای پیک…</p>
        </div>
      </div>
      <textarea id="note" class="note" rows="3" placeholder="یادداشت سفارش…"></textarea>
    </div>
  </div>

  <div class="section">
    <div class="card">
      <p class="name" style="margin-bottom:10px;">اطلاعات تحویل (اختیاری ولی بهتره)</p>
      <input id="customer" class="note" placeholder="نام / شماره تماس" />
      <input id="address" class="note" placeholder="آدرس / لوکیشن / توضیح مسیر" />
    </div>
  </div>
</main>

<div class="stickyCart">
  <div class="cartbar">
    <div>
      <div class="total">سفارش شما آماده ارسال است</div>
      <div class="small"><span id="count">0</span> آیتم انتخاب شده</div>
    </div>
    <div style="display:flex; gap:10px;">
      <button class="btn" id="clear">پاک کردن</button>
      <button class="primary" id="send" disabled>ارسال سفارش در واتساپ</button>
    </div>
  </div>
</div>

<footer>
  © <span id="y"></span> — سفارش واتساپی بدون نمایش قیمت
</footer>

<script>
  // ✅ شماره واتساپ سفارش (با کد کشور، بدون +)
  const WHATSAPP_NUMBER = "905350715215";

  // ✅ منو (بدون قیمت)
  // هر آیتم: { id, cat, name, desc }
  const items = [
    // کباب‌ها
    { id:"k1", cat:"کباب‌ها", name:"کباب کوبیده مخصوص میرزا (۲ سیخ)", desc:"کباب گوشت چرخ‌کرده گاوی که با پیاز و ادویه‌های مخصوص ایرانی مزه‌دار شده و روی آتش کباب می‌شود." },
    { id:"k2", cat:"کباب‌ها", name:"جوجه کباب زعفرانی", desc:"تکه‌های نرم مرغ که با زعفران، ماست و ادویه‌ها مزه‌دار شده و به صورت سیخی کباب می‌شود." },
    { id:"k3", cat:"کباب‌ها", name:"جوجه با استخوان", desc:"مرغ با استخوان که به‌صورت سنتی کباب شده و آبدار و خوش‌عطر است." },
    { id:"k4", cat:"کباب‌ها", name:"کباب چنجه گوسفندی", desc:"تکه‌های گوشت گوسفندی مزه‌دارشده، نرم و لذیذ، کباب‌شده روی سیخ." },
    { id:"k5", cat:"کباب‌ها", name:"کباب برگ مخصوص", desc:"تهیه‌شده از فیله‌ی مرغوب گوشت گاو، بسیار نرم و باکیفیت." },

    // غذاهای سنتی
    { id:"g1", cat:"غذاهای سنتی", name:"زرشک‌پلو با مرغ", desc:"برنج زعفرانی ایرانی همراه با زرشک ترش و خوش‌عطر، سرو شده با مرغ." },
    { id:"g2", cat:"غذاهای سنتی", name:"خورشت قرمه‌سبزی", desc:"مشهورترین غذای ایرانی، تهیه‌شده از سبزی‌های معطر، لوبیا قرمز و گوشت." },
    { id:"g3", cat:"غذاهای سنتی", name:"خورشت قیمه", desc:"خورشتی سنتی با گوشت، لپه و سس گوجه‌فرنگی." },
    { id:"g4", cat:"غذاهای سنتی", name:"غذای روز", desc:"غذای خانگی تازه که هر روز متفاوت و همان روز تهیه می‌شود." },

    // پیش‌غذا و سالاد
    { id:"p1", cat:"پیش‌غذا و سالاد", name:"سالاد شیرازی", desc:"سالاد سبک و تازه از گوجه، خیار و پیاز با طعم لیمو." },
    { id:"p2", cat:"پیش‌غذا و سالاد", name:"ماست موسیر", desc:"ماست سنتی ایرانی با موسیر (نوعی سیر ملایم و معطر)." },
    { id:"p3", cat:"پیش‌غذا و سالاد", name:"ماست و خیار", desc:"ماست مخلوط با خیار و نعناع، خنک و سبک." },
    { id:"p4", cat:"پیش‌غذا و سالاد", name:"زیتون پرورده", desc:"زیتون مزه‌دارشده با گردو، رب انار و ادویه‌های ایرانی." },

    // دسر
    { id:"d1", cat:"دسر", name:"شله‌زرد", desc:"دسر سنتی ایرانی از برنج، زعفران و گلاب." },
    { id:"d2", cat:"دسر", name:"حلوا", desc:"دسر کلاسیک ایرانی از آرد، کره و زعفران." },
    { id:"d3", cat:"دسر", name:"شیربرنج", desc:"دسر سبک و خانگی تهیه‌شده از شیر و برنج." },

    // نوشیدنی
    { id:"n1", cat:"نوشیدنی", name:"دوغ سنتی", desc:"نوشیدنی سنتی ایرانی تهیه‌شده از ماست." },
    { id:"n2", cat:"نوشیدنی", name:"نوشابه", desc:"نوشیدنی‌های گازدار." },
    { id:"n3", cat:"نوشیدنی", name:"آب معدنی", desc:"آب آشامیدنی." },
    { id:"n4", cat:"نوشیدنی", name:"چای ایرانی", desc:"چای سیاه سنتی ایرانی، دم‌کشیده." },
  ];

  const state = { cart: {}, activeCat: "همه" };

  const tabsEl = document.getElementById("tabs");
  const listEl = document.getElementById("list");
  const countEl = document.getElementById("count");
  const sendBtn = document.getElementById("send");
  const clearBtn = document.getElementById("clear");

  document.getElementById("y").textContent = new Date().getFullYear();

  const cats = ["همه", ...Array.from(new Set(items.map(x=>x.cat)))];

  function renderTabs(){
    tabsEl.innerHTML = "";
    cats.forEach(c=>{
      const b = document.createElement("button");
      b.className = "tab" + (c===state.activeCat ? " active" : "");
      b.textContent = c;
      b.onclick = ()=>{ state.activeCat = c; render(); renderTabs(); };
      tabsEl.appendChild(b);
    });
  }

  function calcCount(){
    let count = 0;
    for (const id in state.cart) count += state.cart[id];
    return count;
  }

  function render(){
    const visible = items.filter(x => state.activeCat==="همه" || x.cat===state.activeCat);

    listEl.innerHTML = visible.map(it=>{
      const qty = state.cart[it.id] || 0;
      return `
        <div class="card">
          <div class="row">
            <div>
              <p class="name">${it.name}</p>
              <p class="desc">${it.desc}</p>
            </div>
          </div>

          <div class="controls">
            <button class="btn" onclick="dec('${it.id}')">-</button>
            <div class="qty">${qty}</div>
            <button class="btn" onclick="inc('${it.id}')">+</button>
          </div>
        </div>
      `;
    }).join("");

    const count = calcCount();
    countEl.textContent = count;
    sendBtn.disabled = count === 0;
  }

  window.inc = (id)=>{ state.cart[id] = (state.cart[id]||0)+1; render(); };
  window.dec = (id)=>{ 
    state.cart[id] = Math.max(0,(state.cart[id]||0)-1);
    if(state.cart[id]===0) delete state.cart[id];
    render();
  };

  clearBtn.onclick = ()=>{
    state.cart = {};
    document.getElementById("note").value = "";
    render();
  };

  sendBtn.onclick = ()=>{
    const note = document.getElementById("note").value.trim();
    const customer = document.getElementById("customer").value.trim();
    const address = document.getElementById("address").value.trim();

    const lines = [];
    lines.push("سفارش جدید:");
    lines.push("---------------");

    // گروه‌بندی بر اساس دسته
    for (const cat of cats.filter(c=>c!=="همه")) {
      const catItems = items.filter(it => it.cat===cat && (state.cart[it.id]||0)>0);
      if (catItems.length===0) continue;
      lines.push(cat + ":");
      for (const it of catItems) {
        const q = state.cart[it.id] || 0;
        lines.push(`${q}× ${it.name}`);
      }
      lines.push(" ");
    }

    if(customer) lines.push(`نام/تماس: ${customer}`);
    if(address) lines.push(`آدرس: ${address}`);
    if(note) lines.push(`توضیح: ${note}`);

    const msg = encodeURIComponent(lines.join("\n"));
    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`;
    window.open(url, "_blank");
  };

  renderTabs();
  render();
</script>

</body>
</html>
